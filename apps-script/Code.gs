/**
 * R²-SAFE: คลังมาตรการ (Strategy Bank) เป็น Google Sheets + web app อ่านอย่างเดียว
 *
 * วิธีใช้ (ทำครั้งเดียว)
 * 1) เปิดโครงการ Apps Script ของคุณ วางโค้ดนี้แทน Code.gs ทั้งไฟล์ แล้วบันทึก
 * 2) เลือกฟังก์ชัน setupSheet แล้วกด "เรียกใช้" (ครั้งแรกจะขออนุญาต เข้าถึง Google Sheets ของคุณ)
 *    ระบบจะสร้างสเปรดชีต "R2-SAFE คลังมาตรการ" พร้อมแผ่น "คลังมาตรการ" 68 รายการ และแผ่น "เวอร์ชัน"
 *    (ถ้าโครงการผูกกับสเปรดชีตอยู่แล้ว จะสร้างแผ่นในสเปรดชีตนั้น)
 * 3) Deploy > Manage deployments > แก้ไข (ดินสอ) deployment เดิม > Version: New version > Deploy
 *    ใช้ deployment เดิมเพื่อให้ URL /exec ไม่เปลี่ยน ตั้ง Execute as: Me, Who has access: Anyone
 * 4) เปิด URL /exec ในเบราว์เซอร์ ต้องเห็น JSON ที่มี "ok": true
 *
 * ความปลอดภัย: web app นี้มีเฉพาะ doGet (อ่านอย่างเดียว) ไม่มี doPost จึงรับข้อมูลเข้ามาไม่ได้
 * URL เป็นสาธารณะ ห้ามเก็บข้อมูลโรงเรียนจริงหรือข้อมูลบุคคลในสเปรดชีตนี้
 * ผู้มีสิทธิ์แก้ชีตเท่านั้นแก้คลังได้ ประวัติการแก้ไขดูได้ที่ ไฟล์ > ประวัติเวอร์ชัน
 * เมื่อแก้คลัง (เช่นหลังเดลฟายแต่ละรอบ) ให้อัปเดตแผ่น "เวอร์ชัน" ด้วย
 */
const SHEET_BANK = 'คลังมาตรการ';
const SHEET_VER = 'เวอร์ชัน';
const HEAD = ['id', 'dom', 'name', 'desc', 'elem', 'type3', 'pillar', 'phase', 'res', 'owner', 'kpi', 'risk', 'ready', 'online', 'sb', 'tows', 'target', 'prereq', 'resources', 'output', 'outcome', 'evid', 'status', 'qpri'];
const HEAD_TH = ['รหัสเว็บ', 'ด้านของภัย (V A P H หรือ X ข้ามด้าน)', 'มาตรการ', 'รายละเอียด', '7-S (STG STR SYS STY STF SKL VAL)', 'ประเภท 3 ป.', 'เสาหลัก/รากฐาน CSSF', 'ระยะ', 'ทรัพยากร (1-3)', 'ผู้รับผิดชอบ', 'ตัวชี้วัด', 'เหมาะกับความเสี่ยง (สูง,กลาง,ต่ำ)', 'เหมาะกับความพร้อม (ต่ำ,กลาง,สูง)', 'ออนไลน์ (Y/N)', 'รหัส SB (SB-001)', 'TOWS (SO WO ST WT)', 'กลุ่มเป้าหมาย', 'เงื่อนไขก่อนดำเนินการ', 'ทรัพยากรที่ต้องใช้', 'ผลผลิต', 'ผลลัพธ์ที่คาดหวัง', 'สถานะตรวจหลักฐาน', 'สถานะมาตรการ', 'ลำดับ QSPM (1-20 ว่าง = 1)'];

function doGet(e) {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('bank_json');
  if (hit) return json_(hit);
  const ss = getSS_();
  const sh = ss.getSheetByName(SHEET_BANK);
  if (!sh) return json_(JSON.stringify({ ok: false, error: 'ไม่พบแผ่นคลังมาตรการ ให้รัน setupSheet ก่อน' }));
  const values = sh.getDataRange().getValues();
  const bank = [];
  for (let i = 2; i < values.length; i++) { // แถว 1 = หัวภาษาอังกฤษ, แถว 2 = หัวภาษาไทย
    const r = values[i];
    if (!String(r[0]).trim()) continue;
    const o = {};
    HEAD.forEach(function (k, j) { o[k] = (k === 'res') ? Number(r[j]) : String(r[j]).trim(); });
    bank.push(o);
  }
  const info = {};
  const vs = ss.getSheetByName(SHEET_VER);
  if (vs) vs.getDataRange().getValues().forEach(function (r) { if (r[0]) info[String(r[0])] = (r[1] instanceof Date) ? Utilities.formatDate(r[1], 'Asia/Bangkok', 'yyyy-MM-dd') : String(r[1]); });
  const out = JSON.stringify({ ok: true, version: info.version || '', updated: info.updated || '', note: info.note || '', count: bank.length, bank: bank });
  cache.put('bank_json', out, 60); // แคช 60 วินาที ลดการเรียกชีตซ้ำ
  return json_(out);
}

function json_(text) { return ContentService.createTextOutput(text).setMimeType(ContentService.MimeType.JSON); }

function getSS_() {
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) return active;
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('SS_ID');
  if (id) return SpreadsheetApp.openById(id);
  const ss = SpreadsheetApp.create('R2-SAFE คลังมาตรการ');
  props.setProperty('SS_ID', ss.getId());
  return ss;
}

/** สร้างแผ่นและใส่คลังมาตรการร่างเริ่มต้น 68 รายการ (รันซ้ำจะเขียนทับแผ่นคลังมาตรการ ระวังถ้าแก้ไว้แล้ว) */
function setupSheet() {
  const ss = getSS_();
  let sh = ss.getSheetByName(SHEET_BANK);
  if (sh && sh.getLastRow() > 2) throw new Error('แผ่น "' + SHEET_BANK + '" มีข้อมูลอยู่แล้ว ไม่เขียนทับ ถ้าต้องการเริ่มใหม่ให้ลบแผ่นนั้นก่อน');
  if (!sh) sh = ss.insertSheet(SHEET_BANK);
  sh.clear();
  sh.getRange(1, 1, 1, HEAD.length).setValues([HEAD]).setFontWeight('bold').setBackground('#e8f0fb');
  sh.getRange(2, 1, 1, HEAD.length).setValues([HEAD_TH]).setFontStyle('italic').setBackground('#f3f6fa');
  sh.getRange(3, 1, SEED.length, HEAD.length).setValues(SEED);
  sh.setFrozenRows(2);
  let vs = ss.getSheetByName(SHEET_VER);
  if (!vs) vs = ss.insertSheet(SHEET_VER);
  vs.clear();
  vs.getRange(1, 1, 3, 2).setValues([['version', 'v0.2-draft'], ['updated', new Date()], ['note', 'ร่าง 68 รายการ (SB-001 ถึง SB-068) ยังไม่ตรวจหลักฐานและยังไม่ผ่านเดลฟาย']]);
  CacheService.getScriptCache().remove('bank_json');
  Logger.log('สร้างเสร็จ: ' + ss.getUrl());
}

/** ล้างแคชหลังแก้ชีต ถ้าต้องการให้เว็บเห็นการแก้ไขทันที (ปกติรอ 60 วินาที) */
function clearCache() { CacheService.getScriptCache().remove('bank_json'); }

